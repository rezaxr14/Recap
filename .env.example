# Local development defaults. Copy to .env for overrides.
# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://recap:recap@localhost:5433/recap
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
RECAP_EMBEDDING_PROVIDER=hashing
RECAP_EMBEDDING_DIMENSION=256
RECAP_RERANKER=lexical
RECAP_LOG_LEVEL=INFO
RECAP_ENVIRONMENT=local
