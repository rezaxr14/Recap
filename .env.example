# Local development defaults. Copy to .env for overrides.
# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://recap:recap@localhost:5433/recap
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
RECAP_EMBEDDING_PROVIDER=hashing
RECAP_EMBEDDING_DIMENSION=256
RECAP_RERANKER=lexical
RECAP_LOG_LEVEL=INFO
RECAP_ENVIRONMENT=local

# API-first real models. Uncomment and fill in; never commit real keys.
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
#
# REPAIR_LLM_PROVIDER=openai_compatible
# REPAIR_LLM_BASE_URL=https://api.example.com/v1
# REPAIR_LLM_API_KEY=
# REPAIR_LLM_MODEL=gpt-4.1-mini
# REPAIR_GENERATOR=llm
#
# Local CrossEncoder reranker (no downloads at runtime). Install the extra with
# `pip install -e ".[rerank]"` and point at an existing local directory.
# RERANK_PROVIDER=cross_encoder
# RERANK_MODEL_PATH=models/ms-marco-MiniLM-L-6-v2
