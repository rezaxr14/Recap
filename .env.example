# Local development defaults. Copy to .env for overrides.
# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://recap:recap@localhost:5433/recap
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
# Retrieval depth (opt-in; see docs/retrieval.md and the Phase 4.2 evidence).
# identifier_analysis requires a new index generation + `recap search reindex`.
ELASTICSEARCH_IDENTIFIER_ANALYSIS=false
ELASTICSEARCH_KNN_NUM_CANDIDATES=200
ELASTICSEARCH_DENSE_VECTOR_QUANTIZATION=none
RECAP_EMBEDDING_PROVIDER=hashing
RECAP_EMBEDDING_DIMENSION=256
RECAP_RERANKER=lexical
RECAP_LOG_LEVEL=INFO
RECAP_ENVIRONMENT=local
# Deployments: set both. Empty RECAP_API_KEY disables auth for local/replay use.
RECAP_API_KEY=
RECAP_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# API-first real models. Uncomment and fill in; never commit real keys.
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
# EMBEDDING_READ_TIMEOUT_SECONDS=120
# EMBEDDING_OVERALL_TIMEOUT_SECONDS=300
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# LLM_STREAM=true
# LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_READ_TIMEOUT_SECONDS=600
# LLM_OVERALL_TIMEOUT_SECONDS=900
# LLM_NO_PROGRESS_TIMEOUT_SECONDS=180
# LLM_MAX_CONCURRENCY=1
# LLM_MAX_TOKENS=512
#
# REPAIR_LLM_PROVIDER=openai_compatible
# REPAIR_LLM_BASE_URL=https://api.example.com/v1
# REPAIR_LLM_API_KEY=
# REPAIR_LLM_MODEL=gpt-4.1-mini
# REPAIR_LLM_STREAM=true
# REPAIR_LLM_READ_TIMEOUT_SECONDS=600
# REPAIR_LLM_OVERALL_TIMEOUT_SECONDS=1200
# REPAIR_LLM_NO_PROGRESS_TIMEOUT_SECONDS=240
# REPAIR_LLM_MAX_TOKENS=1024
# REPAIR_GENERATOR=llm
#
# Local CrossEncoder reranker (no downloads at runtime). Install the extra with
# `pip install -e ".[rerank]"` and point at an existing local directory.
# RERANK_PROVIDER=cross_encoder
# RERANK_MODEL_PATH=models/ms-marco-MiniLM-L-6-v2
